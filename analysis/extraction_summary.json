        "f0": "0x0223003A",
        "f1": "0x100AB",
        "msg_id": 22,
        "ps3_pack_id": 2171,
        "pc_pack_id": 1779,
        "ps3_jp": "あんなに傷ついていたのに こんな短期間で……\\nすごいわ",
