    "field_dialogue": [
      {
        "stable_id": "0223001E/00000001/1",
        "pc_source_id": "0223001E/00000001/1",
        "module": "04_field_dialogue",
        "f0": "0x0223001E",
        "f1": "0x1",
        "msg_id": 1,
        "ps3_pack_id": 2001,
        "pc_pack_id": 1782,
        "ps3_jp": "グラフトン船長は通信室にいる。\\nＳRFの船長がほとんどいなくなってしまった今、\\n彼だけが我々の擬りどころだ。<4002>\\pここの基地をざっと見て回ったら、話を聞きに行くといい。",
        "pc_jp": "グラフトン船長は通信室にいる。\\nＳRFの船長がほとんどいなくなってしまった今、\\n彼だけが我々の擬りどころだ。<4002>\\pここの基地をざっと見て回ったら、話を聞きに行くといい。",
        "pc_zh": "库拉福特船长在通信室里。\\n现在几乎失去了所有ＳRF的船长，\\n他是我们唯一的依靠。<4002>\\p随便逛一下基地之后，就去找他吧。",
        "jp_same": true,
        "ctrl_same": true,
        "controls_ps3": "\\n \\n <4002> \\p",
        "controls_pc_zh": "\\n \\n <4002> \\p",
        "ps3_bytes": 162,
        "pc_zh_bytes": 100
      },
      {
        "stable_id": "0223001E/00000001/2",
        "pc_source_id": "0223001E/00000001/2",
        "module": "04_field_dialogue",
        "f0": "0x0223001E",
        "f1": "0x1",
        "msg_id": 2,
        "ps3_pack_id": 2001,
        "pc_pack_id": 1782,
        "ps3_jp": "最初からこうして手を組んで任務を行っていれば、\\n被害は最小限に抑えられたものを……。",
        "pc_jp": "最初からこうして手を組んで任務を行っていれば、\\n被害は最小限に抑えられたものを……。",
        "pc_zh": "一开始就像这样联手执行任务的话，\\n就能大大减少损失了……",
        "jp_same": true,
        "ctrl_same": true,
        "controls_ps3": "\\n",
        "controls_pc_zh": "\\n",
        "ps3_bytes": 81,
        "pc_zh_bytes": 47
      },
      {
        "stable_id": "0223001E/00000001/3",
        "pc_source_id": "0223001E/00000001/3",
        "module": "04_field_dialogue",
        "f0": "0x0223001E",
        "f1": "0x1",
        "msg_id": 3,
        "ps3_pack_id": 2001,
        "pc_pack_id": 1782,
        "ps3_jp": "土産話の大半が苦労話になりそうだな。<4002>\\pそういえばグラフトン船長……っと今は司今だったな……\\nお前たちのことを探していたぞ。\\n何か大事な話があるらしい。行ってみてはどうだ？",
        "pc_jp": "土産話の大半が苦労話になりそうだな。<4002>\\pそういえばグラフトン船長……っと今は司今だったな……\\nお前たちのことを探していたぞ。\\n何か大事な話があるらしい。行ってみてはどうだ？",
        "pc_zh": "旅行见闻大部分都成了苦力见闻。<4002>\\p话说库拉福特船长……现在是司令才对……\\n他在找你们。\\n好像有什么重要的事情。去看看吧？",
        "jp_same": true,
        "ctrl_same": true,
        "controls_ps3": "<4002> \\p \\n \\n",
        "controls_pc_zh": "<4002> \\p \\n \\n",
        "ps3_bytes": 165,
        "pc_zh_bytes": 108
      },
      {
        "stable_id": "0223001E/00000001/4",
        "pc_source_id": "0223001E/00000001/4",
        "module": "04_field_dialogue",
        "f0": "0x0223001E",
        "f1": "0x1",
        "msg_id": 4,
        "ps3_pack_id": 2001,
        "pc_pack_id": 1782,
        "ps3_jp": "君にも、思ってくれる人物がいるのだろう？\\nならば命を粗末にしないことだ。\\n健闘を祈る！新しき船長よ！",
        "pc_jp": "君にも、思ってくれる人物がいるのだろう？\\nならば命を粗末にしないことだ。\\n健闘を祈る！新しき船長よ！",
        "pc_zh": "你也有关心你的人不是吗？\\n那就要好好珍惜自己的生命。\\n祝你好运!新船长!",
        "jp_same": true,
        "ctrl_same": true,
        "controls_ps3": "\\n \\n",
        "controls_pc_zh": "\\n \\n",
        "ps3_bytes": 96,
        "pc_zh_bytes": 66
      },
      {
        "stable_id": "0223001E/00000001/5",
        "pc_source_id": "0223001E/00000001/5",
        "module": "04_field_dialogue",
        "f0": "0x0223001E",
        "f1": "0x1",
        "msg_id": 5,
        "ps3_pack_id": 2001,
        "pc_pack_id": 1782,
        "ps3_jp": "どうだ調子は？\\nこっちはエルダ－の人々とともに、毎日頑張っているよ。",
        "pc_jp": "どうだ調子は？\\nこっちはエルダ－の人々とともに、毎日頑張っているよ。",
        "pc_zh": "感觉怎么样？\\n我们在跟耶鲁达人一起，每天都在努力。",
        "jp_same": true,
        "ctrl_same": true,
        "controls_ps3": "\\n",
        "controls_pc_zh": "\\n",
        "ps3_bytes": 65,
        "pc_zh_bytes": 43
      }
    ],
    "cutscene_story": [
